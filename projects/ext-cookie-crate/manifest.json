{
  "manifest_version": 3,
  "name": "Cookie Crate: Cookie & Storage Editor",
  "short_name": "Cookie Crate",
  "version": "1.0.1",
  "description": "View, edit, add, delete, import and export cookies, localStorage and sessionStorage for the current site. Local only.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Cookie Crate",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_page": "options.html",
  "permissions": ["cookies", "storage", "activeTab", "scripting"],
  "optional_host_permissions": ["<all_urls>"]
}
