{
  "manifest_version": 3,
  "name": "Reload Until: Auto Refresh & Text Alert",
  "short_name": "Reload Until",
  "version": "1.0.1",
  "description": "Auto-refresh a tab and get alerted when text appears or disappears. No tracking, no data collection.",
  "minimum_chrome_version": "137",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Reload Until",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "sw.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["storage", "alarms", "notifications", "scripting", "offscreen", "activeTab"],
  "optional_host_permissions": ["<all_urls>"]
}
