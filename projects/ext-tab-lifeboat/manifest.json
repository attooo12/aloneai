{
  "manifest_version": 3,
  "name": "Tab Lifeboat: Session Saver & Backup",
  "short_name": "Tab Lifeboat",
  "version": "1.0.0",
  "description": "Save and restore tabs, windows and tab groups. Automatic crash snapshots and file backups. Local only, no account.",
  "minimum_chrome_version": "137",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Tab Lifeboat",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "sw.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["tabs", "tabGroups", "storage", "unlimitedStorage", "alarms"],
  "optional_permissions": ["downloads"]
}
